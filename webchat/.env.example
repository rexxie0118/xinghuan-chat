# Copy to `webchat/.env` (auto-loaded on startup), or export variables directly.

# --- server ---------------------------------------------------------------
WEBCHAT_HOST=127.0.0.1
WEBCHAT_PORT=8787

# --- knowledge base -------------------------------------------------------
# mock works offline.
# DeepSeek chat is the quickest real-model setup. It keeps the local hash
# embeddings, so the existing KB does not need a reindex.
#   WEBCHAT_KB_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# ARK / OpenAI-compatible chat + embeddings:
#   WEBCHAT_KB_PROVIDER=ark
#   ARK_API_KEY=...
# Then re-build the KB so embeddings match the new model.
WEBCHAT_KB_PROVIDER=mock
# WEBCHAT_DATA_DIR=./webchat/data
# WEBCHAT_KBS_CONFIG=./webchat/kbs.json

# --- agent service in another repo ---------------------------------------
# When set, /chat is called on every message. Unset = local demo agent.
# WEBCHAT_AGENT_URL=http://127.0.0.1:8790
# WEBCHAT_AGENT_TOKEN=
# WEBCHAT_AGENT_TIMEOUT=25

# --- imported Agent scripts ----------------------------------------------
# Set to 0 to disable script execution entirely (imported Agents still show
# their definitions and can fall back to the knowledge-base answer).
# WEBCHAT_ALLOW_SCRIPT_EXEC=true
# Runner: local (default) | apple-container / docker / k8s once registered
# WEBCHAT_SANDBOX=local
#
# Apple Container (https://github.com/apple/container) requires Apple silicon
# and macOS 26+. Install the CLI and run `container system start` first.
# WEBCHAT_SANDBOX=apple-container
# APPLE_CONTAINER_BIN=container
# APPLE_CONTAINER_IMAGE=python:3.12-slim
# APPLE_CONTAINER_CPUS=2
# APPLE_CONTAINER_MEMORY=2G
# default = internet; isolated/none = host-only internal network (recommended for untrusted scripts)
# APPLE_CONTAINER_NETWORK=isolated
# WEBCHAT_RUNTIME_AUTO_ENSURE=true
# APPLE_POOL_ENABLED=true
# APPLE_POOL_MIN=1
# APPLE_POOL_MAX=4
# APPLE_POOL_PER_USER=2
# WEBCHAT_RUNTIME_IDLE_ENABLED=true
# WEBCHAT_RUNTIME_IDLE_STOP_SECONDS=1800
# WEBCHAT_RUNTIME_IDLE_DELETE_SECONDS=604800
# WEBCHAT_RUNTIME_IDLE_PURGE_SECONDS=2592000
# WEBCHAT_RUNTIME_REAP_INTERVAL=60

# --- tool loop -------------------------------------------------------------
# LLM tool calling over MCP/plugin tools; only Agent mode with tools configured.
# WEBCHAT_TOOL_LOOP_ENABLED=true
# WEBCHAT_TOOL_MAX_STEPS=4

# --- Postgres / Redis / object storage / worker ---------------------------
# Optional infrastructure. Install requirements-infra.txt first.
# WEBCHAT_DB_URL=postgresql://xinghuan:change-me@127.0.0.1:5432/xinghuan
# WEBCHAT_QUEUE_URL=redis://127.0.0.1:6379/0
# WEBCHAT_QUEUE_NAME=webchat:jobs
# WEBCHAT_OBJECT_STORE=local
# WEBCHAT_S3_BUCKET=xinghuan
# WEBCHAT_S3_ENDPOINT=http://127.0.0.1:9000
# WEBCHAT_S3_PREFIX=artifacts
# WEBCHAT_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- evaluation failure injection -----------------------------------------
# Example: inject one tool failure for web.search, then recover.
# WEBCHAT_FAILURE_INJECT='[{"component":"tool","target":"web.search","times":1}]'

# --- concurrency / backpressure -------------------------------------------
# Global worker slots, per-user slots and bounded waiting room.
# WEBCHAT_MAX_CONCURRENT_RUNS=4
# WEBCHAT_MAX_USER_RUNS=1
# WEBCHAT_MAX_QUEUE=32
# WEBCHAT_QUEUE_TIMEOUT_SECONDS=30
# WEBCHAT_RUN_TIMEOUT_SECONDS=180

# --- context budget --------------------------------------------------------
# Conservative token estimate; reserves output tokens before prompt packing.
# WEBCHAT_CONTEXT_MAX_TOKENS=12000
# WEBCHAT_CONTEXT_RESERVE_TOKENS=1200

# --- trusted in-process plugins -------------------------------------------
# Copy plugins.example.json to plugins.json. Only trusted code; no tenant code.
# WEBCHAT_PLUGINS_ENABLED=true
# WEBCHAT_PLUGINS_CONFIG=./webchat/plugins.json
# WEBCHAT_PLUGINS_ALLOW_EXTERNAL=false

# --- web research tools ---------------------------------------------------
# Tavily is preferred; alternatively run a SearXNG JSON endpoint.
# TAVILY_API_KEY=
# WEBCHAT_SEARXNG_URL=http://127.0.0.1:8888
# Optional exact domain allowlist (comma separated). Empty allows all public hosts.
# WEBCHAT_WEB_ALLOW_HOSTS=

# --- MCP tools ------------------------------------------------------------
# Copy mcp.example.json to mcp.json and enable only the servers/tools you trust.
# WEBCHAT_MCP_CONFIG=./webchat/mcp.json
# WEBCHAT_TOOLS_ENABLED=true

# --- GitHub import --------------------------------------------------------
# Needed for private repos and higher GitHub API rate limits.
# GITHUB_TOKEN=

# --- RBAC ---------------------------------------------------------------
# Promote this existing username to admin at startup.
# WEBCHAT_BOOTSTRAP_ADMIN=demo

# --- sessions -------------------------------------------------------------
# WEBCHAT_SESSION_DAYS=7
# WEBCHAT_SECURE_COOKIE=false
# WEBCHAT_SEED_DEMO_USERS=true
