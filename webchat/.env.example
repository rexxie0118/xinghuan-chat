# Copy to `webchat/.env` (auto-loaded on startup), or export variables directly.

# --- server ---------------------------------------------------------------
WEBCHAT_HOST=127.0.0.1
WEBCHAT_PORT=8787

# --- knowledge base -------------------------------------------------------
# mock works offline.
# DeepSeek chat is the quickest real-model setup. It keeps the local hash
# embeddings, so the existing KB does not need a reindex.
#   WEBCHAT_KB_PROVIDER=deepseek
#   DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# ARK / OpenAI-compatible chat + embeddings:
#   WEBCHAT_KB_PROVIDER=ark
#   ARK_API_KEY=...
# Then re-build the KB so embeddings match the new model.
WEBCHAT_KB_PROVIDER=mock
# WEBCHAT_DATA_DIR=./webchat/data
# WEBCHAT_KBS_CONFIG=./webchat/kbs.json

# --- agent service in another repo ---------------------------------------
# When set, /chat is called on every message. Unset = local demo agent.
# WEBCHAT_AGENT_URL=http://127.0.0.1:8790
# WEBCHAT_AGENT_TOKEN=
# WEBCHAT_AGENT_TIMEOUT=25

# --- imported Agent scripts ----------------------------------------------
# Set to 0 to disable script execution entirely (imported Agents still show
# their definitions and can fall back to the knowledge-base answer).
# WEBCHAT_ALLOW_SCRIPT_EXEC=true
# Runner: local (default) | docker / k8s once registered
# WEBCHAT_SANDBOX=local

# --- GitHub import --------------------------------------------------------
# Needed for private repos and higher GitHub API rate limits.
# GITHUB_TOKEN=

# --- sessions -------------------------------------------------------------
# WEBCHAT_SESSION_DAYS=7
# WEBCHAT_SECURE_COOKIE=false
# WEBCHAT_SEED_DEMO_USERS=true
